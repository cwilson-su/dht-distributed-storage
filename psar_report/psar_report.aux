\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}\'Etude de l'approche hi\'erarchis\'ee : HBase}{9}{subsection.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.2.1}Fondamentaux architecturaux de HBase}{9}{subsubsection.1.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Ce diagramme illustre l'architecture distribu\'ee d'Apache HBase et met en \`evidence le probl\`eme de la d\'ecouverte de l'emplacement des r\'egions. Il montre comment deux n\oe uds clients, A et B, interagissent avec le syst\`eme. Les RegionServers et HMaster sont g\'eographiquement distribu\'es sur la carte, soulignant la nature distribu\'ee du cluster. La premi\`ere \`etape, commune, est la recherche de m\'etadonn\'ees (\textbf  {\'etape 1}) : les clients interrogent le coordinateur HMaster/ZooKeeper (localis\'e sur un n\oe ud de datacenter g\'en\'erique) pour trouver le RegionServer responsable de la plage de cl\'es sp\'ecifique. Pour le n\oe ud A, effectuant une op\'eration \texttt  {PUT} (\'ecriture) pour une ligne d'utilisateur, HMaster localise la plage de cl\'es sur le RegionServer 1 (RS1). Le n\oe ud A effectue ensuite directement le \texttt  {PUT} sur RS1 (\textbf  {\'etape 2}), puis RS1 vidange son MemStore vers les HFiles sur les DataNodes HDFS (\textbf  {\'etape 3}). Pour le n\oe ud B, effectuant une op\'eration \texttt  {GET} (lecture) pour une ligne de logs, HMaster localise la plage de cl\'es sur le RegionServer 2 (RS2), puis le n\oe ud B effectue directement le \texttt  {GET} sur RS2 (\textbf  {\'etape 2}). La couche de persistance, situ\'ee en bas, d\'etaille le Write-Ahead Log (donn\'ees WAL) pour la r\'ecup\'eration logique avant persistance et les DataNodes HDFS pour le stockage physique des fichiers HFiles. }}{10}{figure.caption.12}\protected@file@percent }
\newlabel{fig:hbase_architecture_simple}{{10}{10}{Ce diagramme illustre l'architecture distribu\'ee d'Apache HBase et met en \`evidence le probl\`eme de la d\'ecouverte de l'emplacement des r\'egions. Il montre comment deux n\oe uds clients, A et B, interagissent avec le syst\`eme. Les RegionServers et HMaster sont g\'eographiquement distribu\'es sur la carte, soulignant la nature distribu\'ee du cluster. La premi\`ere \`etape, commune, est la recherche de m\'etadonn\'ees (\textbf {\'etape 1}) : les clients interrogent le coordinateur HMaster/ZooKeeper (localis\'e sur un n\oe ud de datacenter g\'en\'erique) pour trouver le RegionServer responsable de la plage de cl\'es sp\'ecifique. Pour le n\oe ud A, effectuant une op\'eration \texttt {PUT} (\'ecriture) pour une ligne d'utilisateur, HMaster localise la plage de cl\'es sur le RegionServer 1 (RS1). Le n\oe ud A effectue ensuite directement le \texttt {PUT} sur RS1 (\textbf {\'etape 2}), puis RS1 vidange son MemStore vers les HFiles sur les DataNodes HDFS (\textbf {\'etape 3}). Pour le n\oe ud B, effectuant une op\'eration \texttt {GET} (lecture) pour une ligne de logs, HMaster localise la plage de cl\'es sur le RegionServer 2 (RS2), puis le n\oe ud B effectue directement le \texttt {GET} sur RS2 (\textbf {\'etape 2}). La couche de persistance, situ\'ee en bas, d\'etaille le Write-Ahead Log (donn\'ees WAL) pour la r\'ecup\'eration logique avant persistance et les DataNodes HDFS pour le stockage physique des fichiers HFiles}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Diagramme simplifi\'e des flux \texttt  {PUT}/\texttt  {GET} dans HBase. Pour un \texttt  {PUT} (client A), le client commence par une r\'esolution de m\'etadonn\'ees (HMaster/cache), envoie l'\'ecriture au RegionServer cibl\'e (MemStore), puis la donn\'ee est s\'ecuris\'ee via le Write-Ahead Log avant d'\^etre persist\'ee sous forme de HFiles sur HDFS (flush p\'eriodique). Pour un \texttt  {GET} (client B), le client r\'esout d'abord la localisation de la r\'egion, interroge le RegionServer cible, puis la valeur est servie depuis le BlockCache ou les HFiles selon la disponibilit\'e des blocs. Cette vue fournit une lecture op\'erationnelle concise des chemins d'\'ecriture et de lecture dans HBase.}}{11}{figure.caption.13}\protected@file@percent }
\newlabel{fig:hbase_put_get_simplified_flow}{{11}{11}{Diagramme simplifi\'e des flux \texttt {PUT}/\texttt {GET} dans HBase. Pour un \texttt {PUT} (client A), le client commence par une r\'esolution de m\'etadonn\'ees (HMaster/cache), envoie l'\'ecriture au RegionServer cibl\'e (MemStore), puis la donn\'ee est s\'ecuris\'ee via le Write-Ahead Log avant d'\^etre persist\'ee sous forme de HFiles sur HDFS (flush p\'eriodique). Pour un \texttt {GET} (client B), le client r\'esout d'abord la localisation de la r\'egion, interroge le RegionServer cible, puis la valeur est servie depuis le BlockCache ou les HFiles selon la disponibilit\'e des blocs. Cette vue fournit une lecture op\'erationnelle concise des chemins d'\'ecriture et de lecture dans HBase}{figure.caption.13}{}}
