\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Architecture interne et fonctionnement du \texttt  {NodeThread}.} Ce diagramme d\'etaille la composition d'un n\oe ud. La fl\`eche verticale symbolise le thread actif, tandis que la bo\^ite 3D repr\'esente l'objet \texttt  {Node} avec son \'etat (\texttt  {id}, \texttt  {running}) et ses structures (\texttt  {peers}, \texttt  {localStore}). La structure \texttt  {Message} est dessin\'ee en gris pour montrer qu'elle est stock\'ee dans la \texttt  {mailbox}. Les mots cl\'es Key et Value sont mis en \'evidence pour montrer le transfert d'information du message vers le stockage local. Les fonctions principales sont aussi d\'ecrites : \texttt  {run()} maintient le n\oe ud actif, \texttt  {receiveMessage()} ajoute les requ\^etes \`a la file, et \texttt  {processMessage()} traite la logique m\'etier.}}{33}{figure.caption.21}\protected@file@percent }
\newlabel{fig:node_thread_architecture}{{10}{33}{\textbf {Architecture interne et fonctionnement du \texttt {NodeThread}.} Ce diagramme d\'etaille la composition d'un n\oe ud. La fl\`eche verticale symbolise le thread actif, tandis que la bo\^ite 3D repr\'esente l'objet \texttt {Node} avec son \'etat (\texttt {id}, \texttt {running}) et ses structures (\texttt {peers}, \texttt {localStore}). La structure \texttt {Message} est dessin\'ee en gris pour montrer qu'elle est stock\'ee dans la \texttt {mailbox}. Les mots cl\'es Key et Value sont mis en \'evidence pour montrer le transfert d'information du message vers le stockage local. Les fonctions principales sont aussi d\'ecrites : \texttt {run()} maintient le n\oe ud actif, \texttt {receiveMessage()} ajoute les requ\^etes \`a la file, et \texttt {processMessage()} traite la logique m\'etier}{figure.caption.21}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Le M\'ecanisme de Communication : La Mailbox}{34}{subsection.6.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}\'Evolution du Message : Du simple "Sender" \`a l'"Origin"}{34}{subsection.6.3}\protected@file@percent }
\newlabel{fig:msg_v0}{{11a}{34}{\textbf {v0} : Limit\'e au \texttt {Sender}}{figure.caption.22}{}}
\newlabel{sub@fig:msg_v0}{{a}{34}{\textbf {v0} : Limit\'e au \texttt {Sender}}{figure.caption.22}{}}
\newlabel{fig:msg_v1}{{11b}{34}{\textbf {v1} : Ajout de \texttt {Origin}}{figure.caption.22}{}}
\newlabel{sub@fig:msg_v1}{{b}{34}{\textbf {v1} : Ajout de \texttt {Origin}}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Comparaison de l'\'evolution de la structure du Message.}}{34}{figure.caption.22}\protected@file@percent }
\newlabel{fig:message_evolution}{{11}{34}{Comparaison de l'\'evolution de la structure du Message}{figure.caption.22}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Mesure du parcours et topologie du syst\`eme}{34}{subsection.6.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Topologie et initialisation du r\'eseau via \texttt  {DHTSystem}.} Ce sch\'ema illustre l'organisation des n\oe uds stock\'es dans une \texttt  {ArrayList}. En bas, la fonction \texttt  {addNode()} est indiqu\'ee comme responsable de l'ajout d'un nouveau n\oe ud et du d\'emarrage de son thread. En haut, la fonction \texttt  {buildDiscoveryChain()} est mise en \'evidence : elle parcourt la liste pour \'etablir des connexions bidirectionnelles entre les n\oe uds voisins. Ces connexions sont mat\'erialis\'ees par les fl\`eches rouges \texttt  {addPeer}, transformant la simple liste en une cha\^ine de propagation op\'erationnelle.}}{35}{figure.caption.23}\protected@file@percent }
\newlabel{fig:dht_system_topology}{{12}{35}{\textbf {Topologie et initialisation du r\'eseau via \texttt {DHTSystem}.} Ce sch\'ema illustre l'organisation des n\oe uds stock\'es dans une \texttt {ArrayList}. En bas, la fonction \texttt {addNode()} est indiqu\'ee comme responsable de l'ajout d'un nouveau n\oe ud et du d\'emarrage de son thread. En haut, la fonction \texttt {buildDiscoveryChain()} est mise en \'evidence : elle parcourt la liste pour \'etablir des connexions bidirectionnelles entre les n\oe uds voisins. Ces connexions sont mat\'erialis\'ees par les fl\`eches rouges \texttt {addPeer}, transformant la simple liste en une cha\^ine de propagation op\'erationnelle}{figure.caption.23}{}}
