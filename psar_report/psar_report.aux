\@writefile{toc}{\contentsline {section}{\numberline {1}Analyse Comparative des Paradigmes Architecturaux de Stockage Distribué}{3}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{1. L'architecture P2P structurée (Les DHTs)}{3}{paragraph*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. L'architecture hiérarchisée orientée colonnes (Modèle HBase)}{3}{paragraph*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Étude des approches P2P structurée: Les DHTs}{3}{subsection.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.1.1}Introduction au problème du Lookup (ref. Section 7.1)}{4}{subsubsection.1.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Le problème du lookup} : le nœud A souhaite stocker un élément de donnée D dans le système distribué. Le nœud B souhaite récupérer D sans connaissance préalable de l'emplacement actuel de D. Comment le système distribué — notamment le placement et la récupération des données — doit-il être organisé (en particulier au regard de la \emph  {scalability} et de l'efficacité) ?}}{4}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:00_lookup_problem}{{1}{4}{\textbf {Le problème du lookup} : le nœud A souhaite stocker un élément de donnée D dans le système distribué. Le nœud B souhaite récupérer D sans connaissance préalable de l'emplacement actuel de D. Comment le système distribué — notamment le placement et la récupération des données — doit-il être organisé (en particulier au regard de la \emph {scalability} et de l'efficacité) ?}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.1.2}Comparaison des stratégies de recherche (ref. Section 7.1.1 - 7.1.5)}{5}{subsubsection.1.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Central Server} : (1) Le nœud A publie son contenu sur le serveur central S. (2) Un nœud B interroge le serveur central S pour obtenir la localisation réelle d'un élément de donnée D. (3) Si celui-ci existe, S répond en indiquant la localisation de D. (4) Le nœud demandeur B télécharge le contenu directement depuis le nœud A.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:01_central_server}{{2}{5}{\textbf {Central Server} : (1) Le nœud A publie son contenu sur le serveur central S. (2) Un nœud B interroge le serveur central S pour obtenir la localisation réelle d'un élément de donnée D. (3) Si celui-ci existe, S répond en indiquant la localisation de D. (4) Le nœud demandeur B télécharge le contenu directement depuis le nœud A}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Flooding Search} : Aucune information de routage n'est maintenue dans les nœuds intermédiaires. (1) Le nœud A envoie une requête pour l'élément D à ses "neighbours" au sein du système distribué. Ces derniers transmettent la requête aux nœuds suivants de manière récursive (\emph  {flooding} / \emph  {breadth-first search}). (2) Le ou les nœuds stockant D envoient une réponse à A, puis A télécharge D directement depuis le ou les nœuds ayant répondu.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:02_flooding_search}{{3}{6}{\textbf {Flooding Search} : Aucune information de routage n'est maintenue dans les nœuds intermédiaires. (1) Le nœud A envoie une requête pour l'élément D à ses "neighbours" au sein du système distribué. Ces derniers transmettent la requête aux nœuds suivants de manière récursive (\emph {flooding} / \emph {breadth-first search}). (2) Le ou les nœuds stockant D envoient une réponse à A, puis A télécharge D directement depuis le ou les nœuds ayant répondu}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  \textbf  {Distributed Hash Table} : Les nœuds du système distribué s'organisent en un \emph  {structured overlay} et établissent une quantité restreinte d'informations de routage afin d'assurer un routage rapide et efficace vers les autres nœuds de l'\emph  {overlay}. (1) Le nœud A envoie une requête pour l'élément D à un nœud arbitraire de la DHT. (2) La requête est transmise selon le routage de la DHT en $O(\log N)$ \emph  {hops} vers le nœud cible. (3) Le nœud cible envoie D au nœud A.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:04_dht_principle}{{4}{6}{\textbf {Distributed Hash Table} : Les nœuds du système distribué s'organisent en un \emph {structured overlay} et établissent une quantité restreinte d'informations de routage afin d'assurer un routage rapide et efficace vers les autres nœuds de l'\emph {overlay}. (1) Le nœud A envoie une requête pour l'élément D à un nœud arbitraire de la DHT. (2) La requête est transmise selon le routage de la DHT en $O(\log N)$ \emph {hops} vers le nœud cible. (3) Le nœud cible envoie D au nœud A}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Comparaison de la complexité en termes d'effort de recherche (axe y) et de coût de stockage par nœud (axe x). Les goulots d'étranglement (\emph  {bottlenecks}) ainsi que les caractéristiques spécifiques de chaque approche sont indiqués.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:03_comparison_central_flooding_dht}{{5}{7}{Comparaison de la complexité en termes d'effort de recherche (axe y) et de coût de stockage par nœud (axe x). Les goulots d'étranglement (\emph {bottlenecks}) ainsi que les caractéristiques spécifiques de chaque approche sont indiqués}{figure.caption.7}{}}
