\newlabel{fig:message_evolution}{{11}{30}{Comparaison de l'\'evolution de la structure du Message}{figure.caption.22}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Mesure du parcours et topologie du syst\`eme}{30}{subsection.6.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Topologie et initialisation du r\'eseau via \texttt  {DHTSystem}.} Ce sch\'ema illustre l'organisation des n\oe uds stock\'es dans une \texttt  {ArrayList}. En bas, la fonction \texttt  {addNode()} est indiqu\'ee comme responsable de l'ajout d'un nouveau n\oe ud et du d\'emarrage de son thread. En haut, la fonction \texttt  {buildDiscoveryChain()} est mise en \'evidence : elle parcourt la liste pour \'etablir des connexions bidirectionnelles entre les n\oe uds voisins. Ces connexions sont mat\'erialis\'ees par les fl\`eches rouges \texttt  {addPeer}, transformant la simple liste en une cha\^ine de propagation op\'erationnelle.}}{31}{figure.caption.23}\protected@file@percent }
\newlabel{fig:dht_system_topology}{{12}{31}{\textbf {Topologie et initialisation du r\'eseau via \texttt {DHTSystem}.} Ce sch\'ema illustre l'organisation des n\oe uds stock\'es dans une \texttt {ArrayList}. En bas, la fonction \texttt {addNode()} est indiqu\'ee comme responsable de l'ajout d'un nouveau n\oe ud et du d\'emarrage de son thread. En haut, la fonction \texttt {buildDiscoveryChain()} est mise en \'evidence : elle parcourt la liste pour \'etablir des connexions bidirectionnelles entre les n\oe uds voisins. Ces connexions sont mat\'erialis\'ees par les fl\`eches rouges \texttt {addPeer}, transformant la simple liste en une cha\^ine de propagation op\'erationnelle}{figure.caption.23}{}}
